{
  "name": "mindbridge-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:web": "tsc -b && vite build",
    "build": "npm run build:web && cap sync",
    "build:ios": "npm run build:web && cap sync ios",
    "build:android": "npm run build:web && cap sync android",
    "ios": "npm run build:ios && cap run ios --no-sync",
    "android": "npm run build:android && cap run android --no-sync",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "lint": "biome lint src --error-on-warnings",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "generate:api": "node scripts/generate-pilot-types.mjs",
    "generate:mobile-learning-types": "node scripts/generate-mobile-learning-types.mjs",
    "check:mobile-learning-types": "node scripts/generate-mobile-learning-types.mjs --check",
    "check:mobile-learning-types:drift": "node scripts/generate-mobile-learning-types.mjs --self-test-drift",
    "check:mobile-learning-artifact": "node scripts/inspect-mobile-learning-artifact.mjs",
    "preview": "vite preview",
    "cap:sync": "cap sync",
    "native:generate": "node scripts/generate-native-projects.mjs && cap sync",
    "native:verify": "node scripts/generate-native-projects.mjs --check",
    "e2e:mobile-learning": "node e2e/run-mobile-learning-backend-e2e.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.4.3",
    "@capacitor/core": "8.4.3",
    "@capacitor/ios": "8.4.3",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@mediapipe/tasks-vision": "1.0.1",
    "phaser": "3.88.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@capacitor/cli": "8.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^27.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^4.1.11"
  }
}
