VITE_API_URL=http://localhost:8000/api/v1
# `npm run dev` turns this on through frontend/.env.development.
# Production builds leave it unset. See docs/adaptive-gamified-learning/local-development.md.
# Engineering E2E assignment only; this is not exposed in child settings.
VITE_MOBILE_LEARNING_CONDITION=baseline
# Episode environment sent to the backend. Valid values: development, test, pilot.
# Pilot builds must set this to "pilot" so the backend marks answers as model-ingestion-eligible.
# Leave unset (or set to "development") for local dev and CI; only set "pilot" on a signed pilot build.
VITE_MOBILE_LEARNING_ENVIRONMENT=development
# Pseudonymous development learner UUID supplied by the seeded backend.
VITE_MOBILE_LEARNING_LEARNER_ID=00000000-0000-4000-8000-000000000721
VITE_TUTOR_DEMO_KEY=
VITE_TUTOR_RESEARCH_KEY=
