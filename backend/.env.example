DATABASE_URL=postgresql+psycopg://mindbridge:change-me@localhost:5432/mindbridge
FRONTEND_ORIGIN=http://localhost:5173

# Knowledge tracing: storage (local folder in development, private S3 bucket in production).
# AWS credentials come from the standard AWS environment/profile, never from this file.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/storage
S3_BUCKET=
S3_REGION=
S3_QUESTION_PREFIX=
SIGNED_URL_SECONDS=600
# Generated papers are written here (local | s3). Use s3 only if the AWS user may write to the bucket.
PAPER_STORAGE_BACKEND=local
# Days after joining before a child can ask for the weekly paper (0 = no waiting).
PAPER_MIN_DAYS_AFTER_JOINING=7

# Knowledge tracing: model and feature spec.
MODEL_WEIGHTS_PATH=app/knowledge_tracing/infrastructure/ml/weights/mindbridge_dkt_v2_best.pt
FEATURE_SPEC_PATH=../shared/feature_spec.json

# Knowledge tracing: vision provider (mock | gemini). Pin the model name; do not leave it empty in production.
# Photos of answered pages are deleted this many days after upload (scripts/delete_old_photos.py)
PHOTO_RETENTION_DAYS=30
# Which reader marks the photographed pages: mock | gemini | openai
VISION_PROVIDER=openai
GEMINI_API_KEY=
GEMINI_MODEL=
# GEMINI_MAX_OUTPUT_TOKENS=4096

# The OpenAI reader (used when VISION_PROVIDER=openai). Name the model you chose: there is no default.
OPENAI_API_KEY=
OPENAI_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MAX_OUTPUT_TOKENS=4096
# OPENAI_IMAGE_DETAIL=high
# Only for models that accept them; leave empty otherwise:
# OPENAI_REASONING_EFFORT=
# OPENAI_TEMPERATURE=
VISION_SECOND_PROVIDER=
# reader_unsure (default) | strict
GRADING_REVIEW_POLICY=reader_unsure
# Read a question again when a part came back blank (one more call per blank question)
GRADING_RECHECK_BLANKS=true
VISION_CONFIDENCE_MIN=0.60
VISION_CONCURRENCY=3
VISION_TIMEOUT_SECONDS=90

# Adaptive Tutor LLM generation (fake | gemini). Selection must be explicit.
TUTOR_LLM_PROVIDER=fake
TUTOR_GEMINI_API_KEY=
TUTOR_GEMINI_MODEL=
TUTOR_GEMINI_TIMEOUT_SECONDS=30
TUTOR_GEMINI_MAX_OUTPUT_TOKENS=512
TUTOR_GEMINI_TEMPERATURE=0.2

# Adaptive Tutor HTTP API (disabled | synthetic-demo). Never enable synthetic mode for learners.
TUTOR_API_MODE=disabled
