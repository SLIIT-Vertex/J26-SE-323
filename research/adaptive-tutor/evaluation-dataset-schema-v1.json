{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindbridge.local/schemas/adaptive-tutor-evaluation-dataset-v1.json",
  "title": "MindBridge Adaptive Tutor Evaluation Dataset V1",
  "description": "Schema family for versioned, non-identifiable Adaptive Tutor research records.",
  "oneOf": [
    {"$ref": "#/$defs/controller_dataset"},
    {"$ref": "#/$defs/transition_dataset"},
    {"$ref": "#/$defs/skill_mapper_dataset"},
    {"$ref": "#/$defs/verifier_dataset"},
    {"$ref": "#/$defs/curriculum_dataset"},
    {"$ref": "#/$defs/baseline_dataset"},
    {"$ref": "#/$defs/expert_review_dataset"}
  ],
  "$defs": {
    "level": {
      "type": "string",
      "enum": ["L0", "L1", "L2", "L3", "L4", "L5", "L6"]
    },
    "nullable_level": {
      "oneOf": [
        {"$ref": "#/$defs/level"},
        {"type": "null"}
      ]
    },
    "common_record": {
      "type": "object",
      "required": [
        "scenario_id",
        "dataset_version",
        "data_origin",
        "label_status",
        "label_author",
        "review_status",
        "independent_labels",
        "actual_learner_observations",
        "dataset_split",
        "source_provenance",
        "skill_id",
        "grade",
        "language",
        "input_evidence",
        "applicable_research_questions",
        "contains_identifiable_child_data"
      ],
      "properties": {
        "scenario_id": {"type": "string", "minLength": 1},
        "dataset_version": {"type": "string", "minLength": 1},
        "data_origin": {
          "enum": ["DESIGN_AUTHORED_SYNTHETIC", "HUMAN_AUTHORED_SYNTHETIC", "REAL"]
        },
        "label_status": {
          "enum": [
            "DESIGN_AUTHORED_UNREVIEWED",
            "HUMAN_REVIEWED",
            "INDEPENDENTLY_LABELLED"
          ]
        },
        "label_author": {"type": "string", "minLength": 1},
        "review_status": {
          "enum": [
            "NOT_REVIEWED",
            "REVIEW_PENDING",
            "HUMAN_REVIEWED",
            "INDEPENDENTLY_LABELLED"
          ]
        },
        "dataset_split": {
          "enum": ["REFERENCE_POLICY", "DEVELOPMENT", "VALIDATION", "TEST"]
        },
        "source_provenance": {"type": "string", "minLength": 1},
        "independent_labels": {"type": "boolean"},
        "actual_learner_observations": {"type": "boolean"},
        "skill_id": {"type": ["string", "null"]},
        "grade": {"type": ["integer", "null"], "enum": [4, 5, null]},
        "language": {"type": ["string", "null"]},
        "input_evidence": {"type": "object"},
        "applicable_research_questions": {
          "type": "array",
          "items": {"type": "string", "pattern": "^RQ[1-9][0-9]*$"},
          "minItems": 1,
          "uniqueItems": true
        },
        "contains_identifiable_child_data": {"const": false}
      }
    },
    "controller_record": {
      "allOf": [
        {"$ref": "#/$defs/common_record"},
        {
          "type": "object",
          "required": ["expected_assistance_level", "observed_assistance_level"],
          "properties": {
            "expected_assistance_level": {"$ref": "#/$defs/level"},
            "observed_assistance_level": {"$ref": "#/$defs/level"},
            "observed_reason_codes": {
              "type": "array",
              "items": {"type": "string"},
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "transition_record": {
      "allOf": [
        {"$ref": "#/$defs/controller_record"},
        {
          "type": "object",
          "required": [
            "previous_assistance_level",
            "expected_transition",
            "observed_transition"
          ],
          "properties": {
            "previous_assistance_level": {"$ref": "#/$defs/nullable_level"},
            "expected_transition": {
              "enum": ["ESCALATION", "MAINTAINED", "FADING", null]
            },
            "observed_transition": {
              "enum": ["ESCALATION", "MAINTAINED", "FADING", null]
            }
          }
        }
      ]
    },
    "skill_mapper_record": {
      "allOf": [
        {"$ref": "#/$defs/common_record"},
        {
          "type": "object",
          "required": [
            "expected_mapping_status",
            "observed_mapping_status",
            "expected_skill_id",
            "observed_skill_id",
            "ranked_candidates"
          ],
          "properties": {
            "expected_mapping_status": {
              "enum": ["MATCHED", "AMBIGUOUS", "NO_MATCH", "NOT_SKILL_RELATED"]
            },
            "observed_mapping_status": {
              "enum": ["MATCHED", "AMBIGUOUS", "NO_MATCH", "NOT_SKILL_RELATED"]
            },
            "expected_skill_id": {"type": ["string", "null"]},
            "observed_skill_id": {"type": ["string", "null"]},
            "ranked_candidates": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["skill_id", "similarity"],
                "properties": {
                  "skill_id": {"type": "string"},
                  "similarity": {"type": "number"}
                },
                "additionalProperties": false
              }
            }
          }
        }
      ]
    },
    "verifier_record": {
      "allOf": [
        {"$ref": "#/$defs/common_record"},
        {
          "type": "object",
          "required": [
            "response_reference",
            "violation_labels",
            "expected_verification_outcome",
            "observed_verification_outcome"
          ],
          "properties": {
            "response_reference": {"type": "string", "minLength": 1},
            "violation_labels": {
              "type": "array",
              "items": {"type": "string"},
              "uniqueItems": true
            },
            "expected_verification_outcome": {"enum": ["PASS", "FAIL", "INDETERMINATE"]},
            "observed_verification_outcome": {"enum": ["PASS", "FAIL", "INDETERMINATE"]}
          }
        }
      ]
    },
    "curriculum_record": {
      "allOf": [
        {"$ref": "#/$defs/common_record"},
        {
          "type": "object",
          "required": [
            "response_reference",
            "evidence_provenance",
            "expected_grounding_valid",
            "observed_grounding_valid"
          ],
          "properties": {
            "response_reference": {"type": "string", "minLength": 1},
            "evidence_provenance": {"type": "array", "items": {"type": "object"}},
            "expected_grounding_valid": {"type": "boolean"},
            "observed_grounding_valid": {"type": ["boolean", "null"]}
          }
        }
      ]
    },
    "baseline_record": {
      "allOf": [
        {"$ref": "#/$defs/common_record"},
        {
          "type": "object",
          "required": ["comparison_condition", "response_reference", "rubric_labels"],
          "properties": {
            "comparison_condition": {
              "enum": [
                "BASELINE_A_CONVENTIONAL_LLM",
                "BASELINE_B_LEARNER_STATE_AWARE_LLM",
                "PROPOSED_FRAMEWORK",
                "ABLATION_WITHOUT_CONTROLLER",
                "ABLATION_WITHOUT_FADING",
                "ABLATION_WITHOUT_VERIFIER"
              ]
            },
            "response_reference": {"type": "string", "minLength": 1},
            "rubric_labels": {"type": "object"}
          }
        }
      ]
    },
    "expert_review_record": {
      "allOf": [
        {"$ref": "#/$defs/common_record"},
        {
          "type": "object",
          "required": ["reviewer_role", "review_disposition", "review_comments"],
          "properties": {
            "reviewer_role": {
              "enum": ["CURRICULUM_SME", "SINHALA_LANGUAGE_REVIEWER", "TAMIL_LANGUAGE_REVIEWER", "PEDAGOGY_REVIEWER"]
            },
            "review_disposition": {"enum": ["ACCEPT", "REVISE", "REJECT"]},
            "review_comments": {"type": "string"},
            "reviewer_reference": {
              "type": ["string", "null"],
              "description": "Non-identifying reviewer provenance reference."
            }
          }
        }
      ]
    },
    "controller_dataset": {
      "$ref": "#/$defs/dataset_wrapper",
      "properties": {"dataset_type": {"const": "CONTROLLER_DECISION"}, "records": {"type": "array", "items": {"$ref": "#/$defs/controller_record"}}}
    },
    "transition_dataset": {
      "$ref": "#/$defs/dataset_wrapper",
      "properties": {"dataset_type": {"const": "TRANSITION_FADING"}, "records": {"type": "array", "items": {"$ref": "#/$defs/transition_record"}}}
    },
    "skill_mapper_dataset": {
      "$ref": "#/$defs/dataset_wrapper",
      "properties": {"dataset_type": {"const": "SKILL_MAPPER"}, "records": {"type": "array", "items": {"$ref": "#/$defs/skill_mapper_record"}}}
    },
    "verifier_dataset": {
      "$ref": "#/$defs/dataset_wrapper",
      "properties": {"dataset_type": {"const": "VERIFIER_VIOLATION"}, "records": {"type": "array", "items": {"$ref": "#/$defs/verifier_record"}}}
    },
    "curriculum_dataset": {
      "$ref": "#/$defs/dataset_wrapper",
      "properties": {"dataset_type": {"const": "CURRICULUM_GROUNDING"}, "records": {"type": "array", "items": {"$ref": "#/$defs/curriculum_record"}}}
    },
    "baseline_dataset": {
      "$ref": "#/$defs/dataset_wrapper",
      "properties": {"dataset_type": {"const": "BASELINE_COMPARISON"}, "records": {"type": "array", "items": {"$ref": "#/$defs/baseline_record"}}}
    },
    "expert_review_dataset": {
      "$ref": "#/$defs/dataset_wrapper",
      "properties": {"dataset_type": {"const": "EXPERT_REVIEW"}, "records": {"type": "array", "items": {"$ref": "#/$defs/expert_review_record"}}}
    },
    "dataset_wrapper": {
      "type": "object",
      "required": ["schema_version", "dataset_version", "dataset_type", "records"],
      "properties": {
        "schema_version": {"const": "adaptive-tutor-evaluation-dataset-v1"},
        "dataset_version": {"type": "string", "minLength": 1},
        "dataset_type": {"type": "string"},
        "records": {"type": "array"}
      },
      "additionalProperties": false
    }
  }
}
