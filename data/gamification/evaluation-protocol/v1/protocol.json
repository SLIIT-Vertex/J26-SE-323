    {
      "arm_key": "proposed_misconception_ig_policy",
      "decision_mode": "learned",
      "ig_feedback": true,
      "exploration_floor": 0.05,
      "requires_approved_artifact": true,
      "measures_independence_gain": true
    }
  ],
  "assignment_unit": "learner",
  "allocation_rule": "sha256-learner-seed-mod-arms",
  "stop_rules": [
    "Stop if the invalid-episode rate exceeds the threshold named in the approved protocol.",
    "Stop if the proposed arm is materially worse on the primary outcome under the approved analysis."
  ],
  "sample_size": "to be confirmed with supervisor/ethics"
}
