# Normalize text files to LF in the repository and in every working tree.
* text=auto eol=lf

# Shell scripts must use LF to run correctly on macOS and Linux.
*.sh text eol=lf

# Source code, configuration, and generated text assets are UTF-8/LF on every platform.
*.py text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
*.properties text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.csv text eol=lf
*.txt text eol=lf

# Windows command scripts require CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files must never be modified by line-ending normalization.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.jar binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.xls binary
*.xlsx binary
